# ==============================================================================
# SupplyChainAgent Production Environment Configuration Template
# Instructions:
# 1. Copy this file to .env.production on your production VPS:
#    cp infra/env/.env.production.example infra/env/.env.production
# 2. Generate strong, unique cryptographic secrets for each PLACEHOLDER below.
# 3. Ensure permissions are restricted: chmod 600 infra/env/.env.production
# 4. NEVER commit .env.production to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ingress Routing & Automatic TLS Certificates (Caddy)
# ------------------------------------------------------------------------------
# Set DOMAIN to your registered public domain (e.g., yourcompany.com)
# Caddy will automatically issue certificates for api.${DOMAIN}
DOMAIN=example.com
ACME_EMAIL=admin@example.com

# ------------------------------------------------------------------------------
# 2. Application Core Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=production
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 3. Cross-Origin Resource Sharing (CORS)
# Authorizes the live Vercel production frontend to communicate with this API
# ------------------------------------------------------------------------------
CORS_ORIGINS=https://frontend-pi-hazel-83.vercel.app

# ------------------------------------------------------------------------------
# 4. Authentication & Security (JWT)
# REQUIRED: Must be at least 32 random characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ------------------------------------------------------------------------------
JWT_SECRET=PLACEHOLDER_REPLACE_WITH_MIN_32_CHAR_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 5. PostgreSQL 16 Relational Database
# Generate password with: python -c "import secrets; print(secrets.token_hex(16))"
# ------------------------------------------------------------------------------
POSTGRES_USER=supplychain
POSTGRES_PASSWORD=PLACEHOLDER_REPLACE_WITH_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=supplychain

# ------------------------------------------------------------------------------
# 6. Redis 7 Cache & Celery Broker
# Generate password with: python -c "import secrets; print(secrets.token_hex(16))"
# ------------------------------------------------------------------------------
REDIS_PASSWORD=PLACEHOLDER_REPLACE_WITH_STRONG_REDIS_PASSWORD

# ------------------------------------------------------------------------------
# 7. Neo4j 5 Community Graph Database
# Generate password with: python -c "import secrets; print(secrets.token_hex(16))"
# ------------------------------------------------------------------------------
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=PLACEHOLDER_REPLACE_WITH_STRONG_NEO4J_PASSWORD
NEO4J_DATABASE=neo4j

# ------------------------------------------------------------------------------
# 8. Asynchronous Worker Concurrency
# ------------------------------------------------------------------------------
CELERY_WORKER_CONCURRENCY=2

# ------------------------------------------------------------------------------
# 9. Centralized LLM Gateway
# Set LLM_MODE=live for real OpenAI/DeepSeek inference, or mock for zero-cost simulated mode
# ------------------------------------------------------------------------------
LLM_MODE=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEFAULT_LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 10. Rate Limiting Configuration
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_UNAUTHENTICATED=30
RATE_LIMIT_AUTHENTICATED=120
RATE_LIMIT_SIMULATION=10
