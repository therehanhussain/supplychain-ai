# ==============================================================================
# SupplyChainAgent - Backend Environment Variables Template
# ==============================================================================
# Duplicate this file to .env and replace placeholder values with your actual config.
# NEVER commit your actual .env file to version control.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000
DEBUG=false

# PostgreSQL Database Configuration
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:your_postgres_password@localhost:5432/supplychain

# Redis Cache & Asynchronous Task Broker
# Format: redis://[:<password>@]<host>:<port>/<db>
REDIS_URL=redis://:your_redis_password@localhost:6379/0

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# Centralized LLM Gateway
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_MODEL=gpt-4o-mini

# Authentication & Security
# Generate with: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Celery Worker Concurrency
CELERY_WORKER_CONCURRENCY=2

# MLflow Tracking Server (Optional)
MLFLOW_TRACKING_URI=http://localhost:59000
